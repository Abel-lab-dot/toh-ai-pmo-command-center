              "id": "b96ee2fe-93ea-4bb0-ae3b-e35a68095fca",
              "name": "email_body",
              "value": "={{ `\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:760px;margin:0 auto;color:#202124;line-height:1.6;\">\n\n  <div style=\"border-bottom:4px solid #d93025;padding-bottom:16px;margin-bottom:24px;\">\n    <div style=\"font-size:12px;font-weight:bold;letter-spacing:1px;color:#666;\">\n      TOH AI PMO COMMAND CENTER\n    </div>\n    <h2 style=\"margin:6px 0 0;font-size:24px;\">\n      Executive Escalation Approved\n    </h2>\n  </div>\n\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:26px;\">\n    <tr>\n      <td style=\"padding:6px 0;width:180px;\"><strong>Project</strong></td>\n      <td style=\"padding:6px 0;\">${$json.project_name}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:6px 0;\"><strong>Project ID</strong></td>\n      <td style=\"padding:6px 0;\">${$json.project_id}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:6px 0;\"><strong>Health Status</strong></td>\n      <td style=\"padding:6px 0;\">\n        <span style=\"background:#fce8e6;color:#b3261e;padding:4px 10px;border-radius:12px;font-weight:bold;\">\n          ${$json.overall_health}\n        </span>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding:6px 0;\"><strong>Health Score</strong></td>\n      <td style=\"padding:6px 0;\">${$json.health_score}</td>\n    </tr>\n  </table>\n\n  <h3 style=\"margin-bottom:6px;\">AI Executive Summary</h3>\n  <div style=\"border-top:1px solid #ddd;padding-top:10px;margin-bottom:24px;\">\n    ${$json.executive_summary}\n  </div>\n\n  <div style=\"background:#e6f4ea;border-left:4px solid #188038;padding:18px 20px;margin-bottom:24px;\">\n    <h3 style=\"margin-top:0;\">Executive Approval</h3>\n\n    <p style=\"margin:6px 0;\">\n      <strong>Decision:</strong> ${$json.decision}\n    </p>\n\n    <p style=\"margin:6px 0;\">\n      <strong>Executive Comment:</strong><br>\n      ${$json.executive_comment || 'No executive comment provided.'}\n    </p>\n  </div>\n\n  <div style=\"background:#f8f9fa;border:1px solid #dadce0;padding:18px 20px;margin-bottom:24px;\">\n    <h3 style=\"margin-top:0;\">Workflow Status</h3>\n\n    <p style=\"margin:6px 0;\">\n      <strong>Escalation Status:</strong>\n      ${$json.escalation_status}\n    </p>\n\n    <p style=\"margin:6px 0;\">\n      <strong>Executive Action:</strong>\n      AUTHORIZED\n    </p>\n  </div>\n\n  <div style=\"background:#fff8e1;border:1px solid #f9ab00;padding:18px 20px;margin-bottom:26px;\">\n    <h3 style=\"margin-top:0;\">Required Action</h3>\n\n    <p style=\"margin:0;\">\n      Executive escalation has been approved. The project team should proceed with the authorized recovery actions and immediate governance intervention.\n    </p>\n  </div>\n\n  <div style=\"border-top:1px solid #ddd;padding-top:18px;color:#777;font-size:12px;\">\n    This notification was generated automatically by the\n    <strong>TOH AI PMO Command Center</strong>\n    following AI project-health analysis and executive approval.\n  </div>\n\n</div>\n` }}",
