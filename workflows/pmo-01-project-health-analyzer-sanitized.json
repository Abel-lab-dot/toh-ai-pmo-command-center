        \"evidence\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\"status\", \"score\", \"evidence\"]\n        },\n        \"risk\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"status\": {\n              \"type\": \"string\",\n              \"enum\": [\"GREEN\", \"AMBER\", \"RED\"]\n            },\n            \"score\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"maximum\": 100\n            },\n            \"evidence\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\"status\", \"score\", \"evidence\"]\n        },\n        \"governance\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"status\": {\n              \"type\": \"string\",\n              \"enum\": [\"GREEN\", \"AMBER\", \"RED\"]\n            },\n            \"score\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"maximum\": 100\n            },\n            \"evidence\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\"status\", \"score\", \"evidence\"]\n        }\n      },\n      \"required\": [\n        \"schedule\",\n        \"budget\",\n        \"delivery\",\n        \"risk\",\n        \"governance\"\n      ]\n    },\n    \"key_findings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"recommended_actions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\"]\n          },\n          \"action\": {\n            \"type\": \"string\"\n          },\n          \"owner_role\": {\n            \"type\": \"string\"\n          },\n          \"due_in_days\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"requires_approval\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"priority\",\n          \"action\",\n          \"owner_role\",\n          \"due_in_days\",\n          \"requires_approval\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"project_id\",\n    \"project_name\",\n    \"overall_health\",\n    \"health_score\",\n    \"executive_summary\",\n    \"dimensions\",\n    \"key_findings\",\n    \"recommended_actions\"\n  ]\n}"
